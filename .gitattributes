# Normalize line endings to LF on commit
* text=auto eol=lf

# Binary files (no line-ending normalization)
*.moc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Text files with explicit LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.mtn text eol=lf
